{
  "name": "focus-assessments",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint || eslint .",
    "format": "prettier -w .",
    "typecheck": "tsc --noEmit",
    "build:prod": "next build",
    "check-db": "node scripts/check-db-schema.js",
    "check-migrations": "node scripts/check-migrations.js",
    "check-user": "node scripts/check-user-org.js",
    "audit:knip": "knip --no-progress",
    "audit:exports": "ts-unused-exports tsconfig.json",
    "audit:deps": "depcheck",
    "audit:types": "tsc --noEmit",
    "audit:eslint": "next lint --max-warnings=0 || true",
    "audit:build": "next build",
    "audit:circles": "madge --circular --extensions ts,tsx app lib components --summary || true",
    "verify": "npm run build && echo Build successful"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@stripe/stripe-js": "^8.1.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.3.0",
    "stripe": "^19.1.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "depcheck": "^1.4.7",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "knip": "^5.66.1",
    "madge": "^8.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.1",
    "ts-unused-exports": "^11.0.1",
    "typescript": "^5"
  }
}
